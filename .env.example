# ===== Kinetic — exemplo de variáveis de ambiente =====
# Copie para um arquivo ".env" e preencha os valores.

# --- Banco de dados (Postgres — obrigatório) ---
# String de conexão do Postgres. Use o Neon (grátis): crie um projeto e copie a
# "Connection string". Funciona tanto local quanto em produção.
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/kinetic?sslmode=require"

# --- Administrador inicial ---
# Criado automaticamente na primeira execução. Defina ANTES do primeiro start.
# É com este e-mail/senha que o admin faz o primeiro login.
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="uma-senha-forte-de-no-minimo-8-caracteres"

# --- Catálogo de exercícios (API externa) ---
# URL base da API de exercícios. Se omitida, usa a padrão hospedada no Render.
EXERCISES_API_URL="https://api-exercicios-fisicos.onrender.com"

# --- IA (tradução de exercícios) ---
# Opcional. Sem chave, o app usa modo de simulação para importar exercícios.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Deploy / URL pública ---
# Usada nos links de redefinição de senha. Em dev, http://localhost:3000.
APP_URL="http://localhost:3000"

# --- E-mail (redefinição de senha) ---
# Opção A (recomendada p/ começar): Gmail com "senha de app" (exige 2FA na conta).
# Gere em https://myaccount.google.com/apppasswords
GMAIL_USER="seu-email@gmail.com"
GMAIL_APP_PASSWORD="a-senha-de-app-de-16-digitos"
# Remetente exibido (opcional; padrão = GMAIL_USER)
MAIL_FROM="seu-email@gmail.com"
#
# Opção B: qualquer SMTP (deixe GMAIL_* vazio se usar isto)
# SMTP_HOST="smtp.seuprovedor.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="usuario"
# SMTP_PASS="senha"
#
# Se nada acima for definido, o link de redefinição é apenas mostrado no console (dev).
